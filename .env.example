# Local dev: SQLite file next to the schema
DATABASE_URL="file:./dev.db"
# Free key from https://www.themoviedb.org/settings/api (v3 API key or v4 Read Access Token)
TMDB_API_KEY=""

# Production (Netlify), set in Site configuration > Environment variables:
#   DATABASE_URL  postgres://... pooled connection string (Neon, Supabase...)
#                 or nothing if you use Netlify DB, which sets NETLIFY_DATABASE_URL itself
#   DIRECT_URL    postgres://... direct (non-pooled) connection, used by `prisma db push` during the build
#   TMDB_API_KEY  same as above
#   CRON_SECRET   any long random string, protects /api/cron/tick
#   NOWPAYMENTS_API_KEY, NOWPAYMENTS_IPN_SECRET  CineCoin purchases (optional)
